# Celery worker for SIEM alert delivery (item 4). Built and started by
# backend/docker-compose.yml — you don't need to build this by hand.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir celery==5.4.0 redis==5.0.8 httpx==0.27.2 python-dotenv==1.0.1

WORKDIR /worker
# Only the alerting package is needed — not the whole backend.
COPY app/__init__.py app/__init__.py
COPY app/alerting app/alerting

RUN useradd --uid 1000 --create-home worker
USER worker

CMD ["celery", "-A", "app.alerting.celery_app", "worker", "--loglevel=info", "--concurrency=2"]