# Copy this file to .env and fill in your real key.
# Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your_key_here

# Model IDs — verify these are still current at https://console.groq.com/docs/models
# before relying on them; Groq deprecates/renames models periodically.
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_SAFETY_MODEL=meta-llama/llama-guard-4-12b

# If unset/invalid, the app still boots — the semantic detection layer and
# TrustReport narrative generation just degrade to structured-only mode.
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db
CORS_ORIGIN=http://localhost:3000

# Optional XLM-R prompt-injection classifier (Layer C). If unset/no checkpoint
# is present at this path, the app boots fine and this layer just reports
# itself unavailable — see backend/models/README.md and app/ml/train_xlmr.py.
XLMR_MODEL_PATH=models/xlmr-prompt-injection
XLMR_CONFIDENCE_THRESHOLD=0.5

# Session isolation. "docker" (default) gives every agent session its own
# isolated container (no network, read-only root, /workspace only) — needs
# Docker Desktop running. "memory" uses in-memory mocks with no containers.
SANDBOX_MODE=docker

# Alert pipeline (item 4). Alerts are always saved and shown in the UI; when
# SIEM_WEBHOOK_URL is set they are ALSO queued in Redis and a Celery worker
# POSTs them to that URL, signed with HMAC-SHA256 using SIEM_WEBHOOK_SECRET.
# Start Redis + the worker with:  docker compose up -d --build   (in backend/)
# For a SIEM on your own PC use http://host.docker.internal:<port>/... here.
REDIS_URL=redis://localhost:6379/0
SIEM_WEBHOOK_URL=
SIEM_WEBHOOK_SECRET=change-me-to-a-long-random-string
ALERT_QUEUE_MODE=celery

# Login (item 5). Secret used to sign login tokens — set a long random value.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty, a random one is made at startup and everyone is logged out on restart.
JWT_SECRET=
   REDIS_URL=redis://localhost:6379/0
   SIEM_WEBHOOK_URL=
   SIEM_WEBHOOK_SECRET=change-me-to-a-long-random-string
   ALERT_QUEUE_MODE=celery
   JWT_SECRET=<paste the printed value here>
   COOKIE_SECURE=false
# Set to true only when serving over HTTPS.
COOKIE_SECURE=false